{
  "$schema": "https://raw.githubusercontent.com/ardia-browser/ardia/main/docs/plugin.v3.schema.json",
  "manifest": 3,
  "id": "@ardia/compact-command-bar",
  "name": "Compact Command Bar",
  "description": "⌘T stops listing your pinned tabs and Top Apps, and shows at most 5 open tabs before you type. Typing still finds every tab.",
  "version": "2.0.0",
  "icon": "command",
  "license": "Apache-2.0",
  "repository": "https://github.com/ardia-browser/plugins",
  "homepage": "https://github.com/ardia-browser/plugins/tree/main/plugins/compact-command-bar",
  "categories": ["productivity"],
  "keywords": ["command bar", "new tab", "tabs", "top apps", "pinned"],
  "engines": {
    "ardia": ">=0.3.0",
    "sdk": "^3.0.0"
  },
  "scope": "global",
  "release": {
    "github": "ardia-browser/plugins",
    "tagPrefix": "compact-command-bar-v",
    "asset": "compact-command-bar-{version}.tar.gz"
  },
  "contributes": {
    "settings": {
      "defaults": {
        "commandBarStart": {
          "openTabs": {
            "hidePinned": true,
            "hideTopApps": true,
            "limit": 5
          }
        }
      }
    }
  }
}
