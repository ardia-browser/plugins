{
  "$schema": "https://raw.githubusercontent.com/ardia-browser/ardia/main/docs/plugin.v3.schema.json",
  "manifest": 3,
  "id": "@ardia/1password",
  "name": "1Password",
  "description": "Fills and saves logins and codes from 1Password, approved in the 1Password app.",
  "version": "1.0.0",
  "icon": "key.horizontal.fill",
  "license": "Apache-2.0",
  "repository": "https://github.com/ardia-browser/plugins",
  "homepage": "https://github.com/ardia-browser/plugins/tree/main/plugins/1password",
  "categories": [
    "passwords",
    "security"
  ],
  "keywords": [
    "1password",
    "agilebits",
    "passwords",
    "one-time codes"
  ],
  "engines": {
    "ardia": ">=0.3.0",
    "sdk": "^3.0.0"
  },
  "scope": "profile",
  "provides": [
    "credentials.provider"
  ],
  "release": {
    "github": "ardia-browser/plugins",
    "tagPrefix": "1password-v",
    "asset": "1password-{version}.tar.gz"
  },
  "main": "dist/index.js",
  "sidecar": {
    "run": [
      "sidecar/server.mjs"
    ],
    "memoryMB": 256
  },
  "memoryMB": 1024,
  "permissions": {
    "storage": true
  },
  "contributes": {
    "passwordManager": {
      "fill": "system",
      "fields": [
        "login",
        "oneTimeCode"
      ],
      "verificationCodeSetup": "system",
      "passkeys": "system"
    }
  }
}
