{
  "$schema": "ardia_cli/schemas/plugin.schema.json",
  "manifest": 1,
  "name": "cli",
  "title": "Command Line",
  "description": "Drive Ardia from your terminal or an agent.",
  "version": "0.4.0",
  "icon": "terminal.fill",
  "alwaysOn": true,
  "official": true,
  "permissions": ["control"],
  "programs": [
    {
      "name": "ardia",
      "path": "bin/ardia",
      "afterUpdate": [["skills", "install", "--auto"], ["skills", "refresh"], ["computer", "refresh"]]
    }
  ]
}
