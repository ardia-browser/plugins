{
 "live_only": "SIGSTOPs Chromium",
 "ops": [
  {
   "op": "open"
  },
  {
   "op": "send",
   "method": "Target.createTarget",
   "params": {
    "url": "about:blank"
   },
   "save": "target",
   "keep": "keys"
  },
  {
   "op": "send",
   "method": "Target.attachToTarget",
   "params": {
    "targetId": "@target.targetId",
    "flatten": true
   },
   "save": "page",
   "keep": "keys"
  },
  {
   "op": "fault",
   "fault": {
    "kind": "stop",
    "at": 1,
    "seconds": 2
   }
  },
  {
   "op": "send",
   "method": "Runtime.evaluate",
   "params": {
    "expression": "1+1",
    "returnByValue": true
   },
   "session": "@page.sessionId",
   "timeout": 1
  },
  {
   "op": "send",
   "method": "Input.dispatchMouseEvent",
   "params": {
    "type": "mouseMoved",
    "x": 1,
    "y": 1
   },
   "session": "@page.sessionId",
   "timeout": 0.5
  },
  {
   "op": "sleep",
   "seconds": 2
  },
  {
   "op": "alive"
  },
  {
   "op": "send",
   "method": "Runtime.evaluate",
   "params": {
    "expression": "1+1",
    "returnByValue": true
   },
   "session": "@page.sessionId"
  },
  {
   "op": "send",
   "method": "Target.closeTarget",
   "params": {
    "targetId": "@target.targetId"
   }
  }
 ]
}
