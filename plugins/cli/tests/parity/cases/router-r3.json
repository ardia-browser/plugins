[
 {
  "id": "router-r3--windows-half-closed-after-hello",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "hello": {
    "result": {
     "app": "Ardia",
     "version": "1.0"
    },
    "then": "half-close"
   },
   "replies": {
    "windows": {
     "result": []
    }
   }
  },
  "note": "Ardia answers hello, then shuts its side for writing while still reading: the next request still goes out and the call fails as dropped"
 },
 {
  "id": "router-r3--tabs-pid-past-the-int-digit-limit",
  "command": "tabs",
  "argv": [
   "tabs",
   "--pid",
   ""
  ],
  "fallback": true,
  "control": {
   "replies": {
    "workspace": {
     "result": {
      "windows": []
     }
    }
   }
  },
  "note": "Python's int() refuses more than 4300 digits, so argparse exits 2 before any socket is opened"
 },
 {
  "id": "router-r3--tabs-pid-at-the-int-digit-limit",
  "command": "tabs",
  "argv": [
   "tabs",
   "--pid",
   ""
  ],
  "control": {
   "replies": {
    "workspace": {
     "result": {
      "windows": []
     }
    }
   }
  },
  "note": "4300 digits is still a number for Python"
 },
 {
  "id": "router-r3--flush-state-nan-failures",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "replies": {
    "windows": {
     "result": []
    }
   }
  },
  "files": {
   "data/Telemetry/cli-flush.json": {
    "text": "{\"failures\":NaN,\"next_at\":0}",
    "mode": 384
   }
  },
  "note": "Python leaves a flush state it can't convert to int (or whose next_at is still ahead) as it is and starts no flusher"
 },
