 {
  "id": "protocol--old-app-windows",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "hello": {
    "result": {
     "app": "Ardia",
     "version": "0.1.0",
     "protocol": 0
    }
   },
   "replies": {
    "windows": {
     "result": []
    }
   }
  },
  "note": "the app is older than the command: it says to update Ardia"
 },
 {
  "id": "protocol--app-refuses-old-command-windows",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "hello": {
    "error": {
     "code": "unsupported_protocol",
     "message": "Ardia 9.0 needs ardia 0.9 or later: update the ardia command (ardia skills refresh after)"
    }
   },
   "replies": {
    "windows": {
     "result": []
    }
   }
  },
  "note": "the app is newer and refuses this command's protocol: the app's words say to update the command"
 },
