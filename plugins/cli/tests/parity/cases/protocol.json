   "open",
   "https://example.com"
  ],
  "control": {
   "hello": {
    "result": {
     "app": "Ardia",
     "version": "0.1.0",
     "protocol": 0
    }
   },
   "replies": {
    "apply": {
     "result": {
      "ok": true,
      "applied": 1,
      "results": [
       {
        "op": "open",
        "tabs": [
         "tab-8"
        ]
       }
      ],
      "tabs": [
       {
        "id": "tab-8",
        "title": "New"
       }
      ]
     }
    }
   }
  },
