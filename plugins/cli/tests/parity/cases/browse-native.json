  "command": "browse get",
  "argv": [
   "browse",
   "--json",
   "--ws",
   "ws://127.0.0.1:9/devtools/browser/abc?k=SECRET12345678",
   "get",
   "title"
  ],
  "daemon": {
   "replies": [
    "close"
   ],
   "endpoint": {
    "ws": "ws://127.0.0.1:9/devtools/browser/abc?k=SECRET12345678"
   },
   "session": "default",
   "namespace": ""
  },
  "intentional": {
   "why": "json errors always carry a code (AI plugin contract)",
   "stdout": {
    "text": "{\"success\":false,\"data\":null,\"error\":\"the ardia browse daemon closed the connection without answering (it may have exited; see the session log)\",\"code\":\"daemon_unreachable\"}\n"
   }
  }
 },
