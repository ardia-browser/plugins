 {
  "id": "browse--raw-not-json",
  "command": "browse get",
  "argv": [
   "browse",
   "get",
   "title"
  ],
  "daemon": {
   "replies": [
    {
     "raw": "nope\n"
    }
   ],
   "endpoint": "token",
   "session": "default",
   "namespace": ""
  },
  "diverges": {
   "why": "Python's client crashes with a traceback when the daemon's answer isn't JSON; Rust has already sent the command, so it reports the broken answer instead",
   "python_crash": "JSONDecodeError",
   "rust_stderr": "\u2717 the ardia browse daemon's answer couldn't be read (it isn't a JSON object); see the session log\n",
   "rust_error_code": "malformed_answer"
  }
 },
