 {
  "id": "windows--lone-surrogates",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "replies": {
    "windows": {
     "raw": "{\"id\":2,\"result\":[{\"id\":1,\"kind\":\"normal\",\"\\ud800\":1,\"\\ud801\":2,\"profileName\":\"\\udfffP\",\"tabs\":[{\"id\":11,\"title\":\"a\\ud83d\\ude00b\\ud83dc\\udc00\",\"url\":\"https://x/\\udbff\",\"\\ud800\":3}]}]}\n"
    }
   }
  },
  "note": "lone surrogate escapes stay distinct (two keys stay two) and become U+FFFD only when written"
 },
 {
  "id": "windows--utf8-encoded-surrogates",
  "command": "windows",
  "argv": [
   "windows"
  ],
  "control": {
   "replies": {
    "windows": {
     "raw": {
      "base64": "eyJpZCI6MiwicmVzdWx0IjpbeyJpZCI6MSwia2luZCI6Im7toIAiLCJ0YWJzIjpbeyJpZCI6MTEsInRpdGxlIjoidO2/vyIsInVybCI6InUifV19XX0K"
     }
    }
   }
  },
  "note": "json.loads decodes UTF-8 with surrogatepass, so an encoded surrogate is read, not refused"
 },
