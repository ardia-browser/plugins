om 0 to 24\nthemes/bad.json: metrics.radius.card isn't a radius key (row, pinned, tile, control, toolbar, panel, sheet)\nthemes/bad.json: layout.hide has \"toolbar\", which isn't a part (pinned, newTab, addressField, navButtons, sidebarButton, downloads, profile)\nthemes/bad.json: layout.hide has 3, which isn't a part (pinned, newTab, addressField, navButtons, sidebarButton, downloads, profile)\nthemes/bad.json: layout.addressField must be one of top, bottom\nthemes/bad.json: icons.plus must be an SF Symbol name (lowercase letters, digits and dots)\nthemes/bad.json: icons has \"Bad Name\", which isn't an SF Symbol name (lowercase letters, digits and dots)\n"}, "stderr": {"text": ""}, "requests": [], "daemon_requests": [], "telemetry": [{"event": "cli_command", "distinct_id": "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b", "timestamp": "<now float s>", "properties": {"command": "config", "subcommand": "check", "exit_code": 1, "error_code": null, "flags": "", "cli_version": "0.0.0.dev0", "$environment": "dev"}, "sent": true}], "queued": [{"event": "cli_command", "distinct_id": "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b", "timestamp": "2026-01-01T00:00:00.000Z", "properties": {"command": "earlier"}}, {"event": "cli_command", "distinct_id": "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b", "timestamp": "<now float s>", "properties": {"command": "config", "subcommand": "check", "exit_code": 1, "error_code": null, "flags": "", "cli_version": "0.0.0.dev0", "$environment": "dev"}}], "usage": {"recent": ["config check (exit 1)"], "tasks": {}}, "flush": {"failures": 0, "next_at": 9000000000000.0}, "files": {"cli-home/Usage": ["written", "dir", 448], "cli-home/Usage/usage.json": ["written", "file", 384, {"text": "<compared apart>"}], "cli-home/Usage/usage.lock": ["written", "file", 384, {"text": ""}], "data/Telemetry/cli-flush-claim.lock": ["written", "file", 384, {"text": ""}], "data/Telemetry/cli-flush.json": ["written", "file", 384, {"text": "<compared apart>"}], "data/Telemetry/cli-queue.jsonl":