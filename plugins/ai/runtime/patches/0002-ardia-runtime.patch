diff --git a/apps/server/src/stripped/disabled.ts b/apps/server/src/stripped/disabled.ts
new file mode 100644
index 0000000000..b0269dd04c
--- /dev/null
+++ b/apps/server/src/stripped/disabled.ts
@@ -0,0 +1,156 @@
+// @effect-diagnostics effectFnOpportunity:off
+import {
+  PreviewStopLocalServerError,
+  type BackgroundPolicySnapshot,
+  type VcsBranchStatus,
+  type VcsStatusLocalResult,
+  type VcsStatusResult,
+  type VcsStatusStreamEvent,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as PubSub from "effect/PubSub";
+import * as Stream from "effect/Stream";
+
+import * as BackgroundPolicy from "../background/BackgroundPolicy.ts";
+import * as PortScanner from "../preview/PortScanner.ts";
+import * as PreviewAgentActivity from "../preview/PreviewAgentActivity.ts";
+import * as WorktreeSetupTracker from "../project/WorktreeSetupTracker.ts";
+import * as AgentAwarenessRelay from "../relay/AgentAwarenessRelay.ts";
+import * as AnalyticsService from "../telemetry/AnalyticsService.ts";
+import * as VcsStatusBroadcaster from "../vcs/VcsStatusBroadcaster.ts";
+
+export const layerAnalyticsDisabled = Layer.succeed(
+  AnalyticsService.AnalyticsService,
+  AnalyticsService.AnalyticsService.of({
+    record: () => Effect.void,
+    flush: Effect.void,
+    recordOwners: () => Effect.void,
+  }),
+);
+
+const unrestrictedBackgroundSnapshot: Effect.Effect<BackgroundPolicySnapshot> = Effect.map(
+  DateTime.now,
+  (now) => ({
+    hostPower: {
+      source: "unknown",
+      idle: "unknown",
+      idleSeconds: null,
+      locked: "unknown",
+      suspended: false,
+      onBattery: "unknown",
+      lowPowerMode: "unknown",
+      thermalState: "unknown",
+      stale: true,
+      updatedAt: now,
+    },
+    leases: [],
+    activeForegroundLeaseCount: 0,
+    activeScopeKeys: [],
+    shouldRunOpportunisticWork: true,
+    updatedAt: now,
+  }),
+);
+
+export const layerBackgroundPolicyDisabled = Layer.succeed(
+  BackgroundPolicy.BackgroundPolicy,
+  BackgroundPolicy.BackgroundPolicy.of({
+    reportClientActivity: () => Effect.void,
+    removeRpcClient: () => Effect.void,
+    snapshot: unrestrictedBackgroundSnapshot,
+    shouldRunScopeWork: () => Effect.succeed(true),
+    shouldRunOpportunisticWork: Effect.succeed(true),
+  }),
+);
+
+export const layerPortDiscoveryDisabled = Layer.succeed(
+  PortScanner.PortDiscovery,
+  PortScanner.PortDiscovery.of({
+    scan: () => Effect.succeed([]),
+    subscribe: () => Effect.void,
+    retain: Effect.void,
+    registerTerminalProcesses: () => Effect.void,
+    unregisterTerminal: () => Effect.void,
+    trackAgent: () => () => undefined,
+    watchAgentCommandStops: () => Effect.void,
+    stopServer: () => Effect.fail(new PreviewStopLocalServerError({ reason: "unsupported" })),
+  }),
+);
+
+export const layerPreviewAgentActivityDisabled = Layer.effect(
+  PreviewAgentActivity.PreviewAgentActivity,
+  Effect.map(PubSub.unbounded<PreviewAgentActivity.PreviewAgentTurnChange>(), (silentChanges) =>
+    PreviewAgentActivity.PreviewAgentActivity.of({
+      begin: () => Effect.succeed(Effect.void),
+      active: () => Effect.succeed(false),
+      changes: PubSub.subscribe(silentChanges),
+    }),
+  ),
+);
+
+const notARepositoryLocalStatus: VcsStatusLocalResult = {
+  isRepo: false,
+  hasPrimaryRemote: false,
+  isDefaultRef: false,
+  refName: null,
+  hasWorkingTreeChanges: false,
+  workingTree: { files: [], insertions: 0, deletions: 0 },
+};
+
+const notARepositoryStatus: VcsStatusResult = {
+  ...notARepositoryLocalStatus,
+  hasUpstream: false,
+  aheadCount: 0,
+  behindCount: 0,
+  pr: null,
+};
+
+const notARepositoryBranchStatus: VcsBranchStatus = { refName: null, isRepo: false };
+
+const notARepositoryStatusSnapshot: VcsStatusStreamEvent = {
+  _tag: "snapshot",
+  local: notARepositoryLocalStatus,
+  remote: null,
+};
+
+export const layerVcsStatusBroadcasterDisabled = Layer.succeed(
+  VcsStatusBroadcaster.VcsStatusBroadcaster,
+  VcsStatusBroadcaster.VcsStatusBroadcaster.of({
+    streamBranchStatus: () => Stream.concat(Stream.make(notARepositoryBranchStatus), Stream.never),
+    refreshBranchStatus: () => Effect.succeed(notARepositoryBranchStatus),
+    streamBranchChanges: Stream.never,
+    getStatus: () => Effect.succeed(notARepositoryStatus),
+    refreshLocalStatus: () => Effect.succeed(notARepositoryLocalStatus),
+    refreshAfterCheckout: () => Effect.void,
+    refreshStatus: () => Effect.succeed(notARepositoryStatus),
+    refreshPullRequestStatus: () => Effect.succeed(null),
+    streamStatus: () => Stream.concat(Stream.make(notARepositoryStatusSnapshot), Stream.never),
+  }),
+);
+
+export const layerWorktreeSetupTrackerDisabled = Layer.succeed(
+  WorktreeSetupTracker.WorktreeSetupTracker,
+  WorktreeSetupTracker.WorktreeSetupTracker.of({
+    begin: () => Effect.void,
+    update: () => Effect.void,
+    stage: () => Effect.void,
+    stageStatus: () => Effect.void,
+    appendTail: () => Effect.void,
+    finish: () => Effect.succeed(null),
+    markUncancellable: () => Effect.void,
+    cancel: () => Effect.succeed(false),
+    get: () => Effect.succeed(null),
+    stream: () => Stream.concat(Stream.make(null), Stream.never),
+  }),
+);
+
+export const layerAgentAwarenessRelayDisabled = Layer.succeed(
+  AgentAwarenessRelay.AgentAwarenessRelay,
+  AgentAwarenessRelay.AgentAwarenessRelay.of({
+    publishThread: () => Effect.void,
+    drain: Effect.void,
+    requestCatchUp: () => Effect.void,
+    start: () => Effect.void,
+  }),
+);
