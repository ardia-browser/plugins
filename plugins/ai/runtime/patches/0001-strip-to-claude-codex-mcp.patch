+import type * as Context from "effect/Context";
+import * as Schema from "effect/Schema";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+export class FeatureRemovedError extends Schema.TaggedError<FeatureRemovedError>()(
+  "FeatureRemovedError",
+  { service: Schema.String, member: Schema.String },
+) {
+  override get message() {
+    return `${this.service}.${this.member} is not part of this server`;
+  }
+}
+
+export const removedCall = (service: string, member: string) =>
+  Effect.die(new FeatureRemovedError({ service, member }));
+
+const removedMember = (service: string, member: string, quiet: boolean) => {
+  const effect = quiet ? Effect.void : removedCall(service, member);
+  const member_ = function () {
+    return effect;
+  };
+  Object.setPrototypeOf(member_, Object.getPrototypeOf(effect));
+  for (const key of Reflect.ownKeys(effect)) {
+    Object.defineProperty(member_, key, Reflect.getOwnPropertyDescriptor(effect, key)!);
+  }
+  return member_;
+};
+
+export const removedShape = <Shape>(
+  service: string,
+  kept: Partial<Shape> = {},
+  quiet = false,
+): Shape => {
+  const members = new Map<string, unknown>();
+  return new Proxy(kept as object, {
+    get(target, property) {
+      if (property in target) return Reflect.get(target, property);
+      if (typeof property === "symbol" || property === "then" || property === "toJSON") {
+        return undefined;
+      }
+      let member = members.get(property);
+      if (member === undefined) {
+        member = removedMember(service, property, quiet);
+        members.set(property, member);
+      }
+      return member;
+    },
+  }) as Shape;
+};
+
+export const removed = <Identifier, Shape>(
+  key: Context.Key<Identifier, Shape>,
+  kept: Partial<Shape> = {},
+): Layer.Layer<Identifier> => Layer.succeed(key, removedShape<Shape>(key.key, kept));
+
+export const quiet = <Identifier, Shape>(
+  key: Context.Key<Identifier, Shape>,
+  kept: Partial<Shape> = {},
+): Layer.Layer<Identifier> => Layer.succeed(key, removedShape<Shape>(key.key, kept, true));
